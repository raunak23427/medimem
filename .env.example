# ─── Firebase (required for live / production builds) ────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_REGION=us-central1

# ─── Runtime mode ─────────────────────────────────────────────
# Set to 'true' to force the local Sharma-family demo path even when the
# Firebase env vars above are present. Unset / 'false' = live mode.
VITE_DEMO_MODE=

# Point the SDK at locally-running Firebase emulators (npm run emulators).
# Useful for development; MUST be unset in production builds.
VITE_USE_EMULATORS=

# ─── DEV-ONLY: direct Hugging Face token ──────────────────────
# Setting this token in a frontend build SHIPS IT to every client. Never set
# it in production. The production AI path goes through Cloud Functions where
# the token lives as a Functions secret (HF_TOKEN). See SECURITY.md.
VITE_HF_API_KEY=
